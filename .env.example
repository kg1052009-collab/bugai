# Bug Voice Assistant Environment Configuration
# Copy this file to .env and customize as needed

# Wake word (what phrase activates the assistant)
BUG_WAKE_WORD="hey bug"

# Vosk model path
BUG_VOSK_MODEL="models/vosk-model-small-en-us-0.15"

# Ollama model name
BUG_OLLAMA_MODEL="llama3.1"

# Ollama timeout in seconds
BUG_OLLAMA_TIMEOUT=30

# Sentiment analysis thresholds (-1.0 to 1.0)
BUG_POSITIVE_THRESHOLD=0.3
BUG_NEGATIVE_THRESHOLD=-0.3

# Maximum conversation turns to remember
BUG_MAX_MEMORY=10

# Response timeout in seconds
BUG_RESPONSE_TIMEOUT=5.0

# TTS (Text-to-Speech) settings
BUG_TTS_RATE=200
BUG_TTS_VOLUME=0.9
